# Copy to .env.local for development. Never commit real values (.gitignore keeps .env* out).
# Used from step 7 (sync). A guest never contacts any of these.
VITE_API_BASE_URL=https://api.example.invalid
VITE_SUPABASE_URL=https://your-project.supabase.co
# The Supabase "anon"/publishable key is public by design (RLS protects data); still kept out of git per environment.
VITE_SUPABASE_ANON_KEY=
